{
	"apiVersion": 1,
	"id": "agentero.reading-tools",
	"version": "1.0.0",
	"name": { "en": "Reading tools", "zh-CN": "阅读工具" },
	"permissions": ["vault:read", "catalog:write", "vault:notes:write"],
	"commands": [
		{
			"id": "mark-read",
			"title": { "en": "Mark paper as read", "zh-CN": "标记论文为已读" }
		},
		{
			"id": "save-selection",
			"title": { "en": "Save selection to notes", "zh-CN": "将选区保存到笔记" }
		},
		{
			"id": "visits",
			"title": { "en": "Show reading count", "zh-CN": "查看阅读次数" }
		}
	],
	"menus": [
		{ "menu": "library.row", "command": "mark-read" },
		{ "menu": "fileTree.item", "command": "mark-read" },
		{ "menu": "pdf.selection", "command": "save-selection" }
	],
	"events": ["paper:opened"],
	"settings": [
		{
			"key": "heading",
			"title": { "en": "Notes heading", "zh-CN": "笔记标题" },
			"kind": "string",
			"default": "Highlights"
		}
	]
}
